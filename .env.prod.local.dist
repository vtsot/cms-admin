# Copy to .env.prod.local (git-ignored) and fill in. Used by docker-compose.prod.yaml.

# compose
APP_IMAGE=cms-admin
APP_TAG=latest
HTTP_PORT=80
# run doctrine migrations when php-fpm starts (1/0)
RUN_MIGRATIONS=1

# database (the mysql service is created with these credentials on first start)
MYSQL_DATABASE=cms_admin
MYSQL_USER=cms_admin
MYSQL_PASSWORD=!ChangeMe!
MYSQL_ROOT_PASSWORD=!ChangeMe!

# application
APP_SECRET=!ChangeMe!
TIMEZONE=UTC
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
DEFAULT_URI=https://admin.example.com/
DEFAULT_LOCALE=en_GB
LOCALES=["en_GB","uk_UA","ru_UA"]
CORS_ALLOW_ORIGIN=^https?://(admin|api)\.example\.com$
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
