{% extends "@SonataAdmin/CRUD/list_url.html.twig" %}
{# @var \App\Admin\MailLogAdmin admin #}
{# @var \App\Entity\MailLog object #}

{% block field %}
    {% if object.site %}
        {% set url = path('admin.site_list', {
            'filters': 'reset',
            'filter': {'domain': {'value': object.site.domain|replace({'http://': '', 'https://': ''})}}
        }) %}

        {%- include '@SonataAdmin/CRUD/display_url.html.twig' with {
            value: object.site.title,
            url: url,
            hide_protocol: field_description.option('hide_protocol'),
            attributes: field_description.option('attributes'),
            safe: field_description.option('safe'),
        } only -%}
    {% else %}
        N/A
    {% endif %}
{% endblock %}
