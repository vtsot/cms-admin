{% extends "@SonataAdmin/CRUD/list_boolean.html.twig" %}
{# @var \App\Admin\Content\AbstractPageAdmin admin #}
{# @var \App\Entity\Page\Page object  #}

{%- block field_span_attributes -%}
    {% set is_editable = field_description.option('editable', false) and admin.hasAccess('edit', object) and not object.homepage %}
    {% set x_editable_type = field_description.type|sonata_xeditable_type %}
    {% if is_editable and x_editable_type %}
        {{ parent() }}
    {% endif %}
{%- endblock -%}
