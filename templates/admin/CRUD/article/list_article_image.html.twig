{% extends '@SonataAdmin/CRUD/list_string.html.twig' %}
{# @var \App\Admin\Site\SiteArticleAdmin admin #}
{# @var \App\Entity\Page\Article object #}
{# @var array{width: int, height: int} desktopSize #}

{% block field %}
    {% set imageRouteName = field_description.options.data.imageRouteName ?? null %}
    {% set imageType = field_description.options.data.imageType ?? null %}

    {% set desktopSizes = constant('App\\DTOFactory\\Entity\\Page\\ArticleDTOFactory::DESKTOP_SIZE') ?? null %}
    {% set desktopSize = desktopSizes['default'] %}

    {% if attribute(object, 'image') is defined and object.image is not null and imageRouteName %}
        <div>
            {% set previewWidth = desktopSize.width ?? 200 %}
            {% set previewHeight = desktopSize.height ?? 200 %}
            {% set downloadWidth = field_description.options.data.downloadWidth ?? 9999 %}
            {% set downloadHeight = field_description.options.data.downloadHeight ?? 9999 %}

            {% set imageUrlThumbnail = url(imageRouteName, {'type': imageType, 'crop' : 'resize', 'width': previewWidth, 'height': previewHeight, 'image' : object.image }) %}
            {% set imageUrlDownload = url(imageRouteName, {'type': imageType, 'crop' : 'resize', 'width': downloadWidth, 'height': downloadHeight, 'image' : object.image }) %}

            <a href="{{ imageUrlDownload }}" target="_blank">
                <img src="{{ imageUrlThumbnail }}" alt="{{ object.imageAlt ?? object.title }}">
            </a>
        </div>
    {% endif %}
{% endblock %}
