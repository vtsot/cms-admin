{% extends '@SonataAdmin/CRUD/base_show_field.html.twig' %}
{# @var \App\Admin\Site\SiteEmailTemplateAdmin admin #}
{# @var \App\Entity\EmailTemplate object #}

{% block field %}
    {% set showTextUrl = admin.hasAccess('show_text', object) and admin.hasRoute('show_text')
        ? admin.generateObjectUrl('show_text', object)
        : null %}

    <iframe id="mail-log-text"
            src="{{ showTextUrl }}"
            width="100%" height="500px" frameborder="0"
            style="border: 1px dashed grey"
    ></iframe>
    {% if showTextUrl is null %}
        {% set html = object.text | replace({"\r\n": '<br>'}) | replace({"\n": '<br>'}) | replace({"\r": '<br>'}) | replace({"\n": '<br>'})  %}
        <script>
            $(document).ready(() => {
                $('#mail-log-text').contents().find('html').html('{{ html | raw }}');
            });
        </script>
    {% endif %}
{% endblock %}
