{% extends "@SonataAdmin/CRUD/list_boolean.html.twig" %}
{# @var \App\Admin\Site\SiteEmailTemplateAdmin admin #}
{# @var \App\Entity\EmailTemplate object  #}

{% block field_span_attributes %}
    {% set is_editable = field_description.option('editable', false) and admin.hasAccess('edit', object) and admin.editableActiveFieldForTemplate(object) %}
    {% set x_editable_type = field_description.type|sonata_xeditable_type %}
    {% if is_editable and x_editable_type %}
        {% apply spaceless %}
            {{ parent() }}
        {% endapply %}
    {% endif %}
{% endblock %}
