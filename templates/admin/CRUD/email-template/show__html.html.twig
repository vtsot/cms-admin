{% extends '@SonataAdmin/CRUD/base_show_field.html.twig' %}
{# @var \App\Admin\Site\SiteEmailTemplateAdmin admin #}
{# @var \App\Entity\EmailTemplate object #}

{% block field %}
    {% set showHtmlUrl = admin.hasAccess('show_html', object) and admin.hasRoute('show_html')
        ? admin.generateObjectUrl('show_html', object)
        : null %}

    <iframe id="mail-log-html"
            src="{{ showHtmlUrl }}"
            width="100%" height="500px" frameborder="0"
            style="border: 1px dashed grey"
    ></iframe>
    {% if showHtmlUrl is null %}
        {% set html = object.html | replace({"\r\n": '<br>'}) | replace({"\n": '<br>'}) | replace({"\r": '<br>'}) | replace({"\n": '<br>'})  %}
        <script>
            $(document).ready(() => {
                $('#mail-log-html').contents().find('html').html('{{ html | raw }}');
            });
        </script>
    {% endif %}
{% endblock %}
