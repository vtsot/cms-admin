{% extends '@SonataAdmin/CRUD/base_list_field.html.twig' %}
{# @var \App\Admin\Review\ReviewAdmin admin #}
{# @var \App\Entity\Review\Review object #}

{% block field %}
    <div>
        <strong>{{ 'REVIEW_ENTITY.LABEL.AUTHOR.TYPE'|trans({}, 'admin-messages') }}:</strong>
        {{ object.authorType ? object.authorType.name : '-' }}
    </div>

    <div>
        <strong>{{ 'REVIEW_ENTITY.LABEL.AUTHOR.GENDER'|trans({}, 'admin-messages') }}:</strong>
        {{ object.authorGender ? object.authorGender.name : '-' }}
    </div>

    <div>
        <strong>{{ 'REVIEW_ENTITY.LABEL.AUTHOR.AGE'|trans({}, 'admin-messages') }}:</strong>
        {{ object.authorAge ? object.authorAge.title : '-'  }}
    </div>

    <div>
        <strong>{{ 'REVIEW_ENTITY.LABEL.AUTHOR.NAME'|trans({}, 'admin-messages') }}:</strong>
        {{ object.authorName ? object.authorName : '-'  }}
    </div>

    <div>
        <strong>{{ 'REVIEW_ENTITY.LABEL.FULL_NAME'|trans({}, 'admin-messages') }}:</strong>
        {{ object.fullName ? object.fullName : '-'  }}
    </div>

    <div>
        <strong>{{ 'REVIEW_ENTITY.LABEL.EMAIL'|trans({}, 'admin-messages') }}:</strong>
        {{ object.email ? object.email : '-'  }}
    </div>

{% endblock %}
