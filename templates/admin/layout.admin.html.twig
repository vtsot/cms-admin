{% extends '@SonataAdmin/standard_layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}

    {{ encore_entry_link_tags('css/admin') }}
{% endblock %}

{%- block logo -%}
    <a class="logo" href="{{ path('sonata_admin_dashboard') }}" style="background-color: #222d32">
        <img src="{{ asset('assets/images/admin/logo.jpg') }}" alt="">
    </a>
{%- endblock -%}

{%- block sonata_top_nav_menu -%}
    <a class="exit-btn" href="{{ path('admin.logout') }}">
        {{ 'AUTH.LOGOUT'|trans({}, 'admin-messages') }}
    </a>
{%- endblock -%}

{% block side_bar_after_nav %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        $(document).ready(() => {
            // submit filter form when filter removed
            $('form.sonata-filter-form a.sonata-ba-action').on('click', function () {
                const form = $(this).closest('form');

                if (form.length === 1) {
                    form.find('button[type=submit]').trigger('click');
                }
            });
        });
    </script>
{% endblock %}
