{# @see /vendor/vich/uploader-bundle/templates/Form/fields.html.twig #}
{% extends '@!VichUploader/Form/fields.html.twig' %}

{%- block vich_image_widget -%}
    <div class="vich-image">
        {%- if errors|length > 0 -%}
            {%- set attr = attr|merge({class: (attr.class|default('') ~ ' is-invalid')|trim}) -%}
        {%- endif -%}
        {{- form_widget(form.file, {attr: attr}) -}}
        {%- if form.delete is defined -%}
            {{- form_row(form.delete) -}}
        {%- endif -%}

        {% set width = attr.width ?? null %}
        {% set height = attr.height ?? null %}
        {% set download = not (attr['no-download'] ?? false) %}

        {%- if image_uri -%}
            <a href="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}"
                {{ download ? ' download ' : ' target="_blank" ' }}
            >
                <img src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" alt=""
                     style="max-width: 100%;"
                    {% if width %} width="{{ width }}"{% endif %}
                    {% if height %} width="{{ height }}"{% endif %}
                />
            </a>
        {%- endif -%}
        {%- if download_uri -%}
            <div>
                <a href="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}"
                    {{ download ? ' download ' : ' target="_blank" ' }}
                >
                    {{ translation_domain is same as(false) ? download_label : download_label|trans({}, translation_domain) }}
                </a>
            </div>
        {%- endif -%}
    </div>
{%- endblock -%}
