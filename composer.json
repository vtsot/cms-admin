{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "beberlei/doctrineextensions": "^1.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "friendsofsymfony/ckeditor-bundle": "^2.8",
        "helios-ag/fm-elfinder-bundle": "^14.0",
        "intervention/image": "^4.4",
        "league/flysystem": "^3.36",
        "league/flysystem-bundle": "^3.7",
        "nelmio/api-doc-bundle": "^5.13",
        "nelmio/cors-bundle": "^2.6",
        "nesbot/carbon": "^3.15",
        "sonata-project/admin-bundle": "^4.43",
        "sonata-project/doctrine-orm-admin-bundle": "^4.21",
        "sonata-project/google-authenticator": "^2.3",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": "8.1.*",
        "vich/uploader-bundle": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "ckeditor:install": "symfony-cmd",
            "elfinder:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "install-editor": [
            "@php ./bin/console ckeditor:install --exclude=samples --exclude=adapters --clear=drop --tag=4.22.1",
            "@php ./bin/console assets:install",
            "@php ./bin/console elfinder:install"
        ],
        "lint": [
            "PHP_CS_FIXER_IGNORE_ENV=1 php -d pcov.enabled=0 -d memory_limit=-1 ./vendor/friendsofphp/php-cs-fixer/php-cs-fixer check -v"
        ],
        "lint:junit": [
            "PHP_CS_FIXER_IGNORE_ENV=1 php -d pcov.enabled=0 -d memory_limit=-1 ./vendor/friendsofphp/php-cs-fixer/php-cs-fixer check -v --format=junit > ./tests/_output/php-cs-report.xml"
        ],
        "lint:fix": [
            "PHP_CS_FIXER_IGNORE_ENV=1 php -d pcov.enabled=0 -d memory_limit=-1 ./vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix"
        ],
        "test": [
            "@php -d pcov.enabled=0 -d memory_limit=-1 ./vendor/bin/codecept run -s acceptance"
        ],
        "test:api": [
            "@php -d pcov.enabled=0 -d memory_limit=-1 ./vendor/bin/codecept run api"
        ],
        "test:unit": [
            "@php -d pcov.enabled=0 -d memory_limit=-1 ./vendor/bin/codecept run unit"
        ],
        "test:web": [
            "@php -d pcov.enabled=0 -d memory_limit=-1 ./vendor/bin/codecept run web"
        ],
        "test:coverage": [
            "@php -d pcov.enabled=1 -d opcache.jit=0 -d memory_limit=-1 ./vendor/bin/codecept run -s acceptance -s web --coverage"
        ],
        "test:coverage-html": [
            "@php -d pcov.enabled=1 -d opcache.jit=0 -d memory_limit=-1 ./vendor/bin/codecept run -s acceptance -s web --coverage-html"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "symfony/maker-bundle": "^1.68",
        "symfony/web-profiler-bundle": "8.1.*"
    }
}
